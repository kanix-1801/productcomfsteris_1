/**
 * @description Test class for ReturnOrders domain class.
 *              Covers constructor and domain exception.
 */
@IsTest
private class ReturnOrdersTest {

    @IsTest
    static void shouldConstructDomain_WhenValidRecordListProvided() {
        /********************************************
         * SETUP
         ********************************************/
        User testUser = new User(id=UserInfo.getUserId()); // Use current user to avoid permission issues in test context

        System.runAs(testUser) {
            /********************************************
             * GIVEN
             ********************************************/
            List<ReturnOrder> returnOrderList = new List<ReturnOrder>{
                (ReturnOrder) new adb_ReturnOrder().status('Draft').record,
                (ReturnOrder) new adb_ReturnOrder().status('Draft').record
            };

            /********************************************
             * WHEN
             ********************************************/
            Test.startTest();
            ReturnOrders domain = new ReturnOrders(returnOrderList);
            Test.stopTest();

            /********************************************
             * THEN
             ********************************************/
            Assert.isNotNull(domain, 'Domain instance should be created from a valid record list');
        }
    }

    @IsTest
    static void shouldConstructDomain_WhenEmptyListProvided() {
        /********************************************
         * SETUP
         ********************************************/
        User testUser = new User(id=UserInfo.getUserId()); // Use current user to avoid permission issues in test context

        System.runAs(testUser) {
            /********************************************
             * WHEN
             ********************************************/
            Test.startTest();
            ReturnOrders domain = new ReturnOrders(new List<ReturnOrder>());
            Test.stopTest();

            /********************************************
             * THEN
             ********************************************/
            Assert.isNotNull(domain, 'Domain instance should be created from an empty list without error');
        }
    }

    @IsTest
    static void shouldThrowReturnOrdersException_WhenExceptionIsRaised() {
        /********************************************
         * SETUP
         ********************************************/
        User testUser = new User(id=UserInfo.getUserId()); // Use current user to avoid permission issues in test context

        System.runAs(testUser) {
            /********************************************
             * WHEN / THEN
             ********************************************/
            Test.startTest();
            try {
                throw new ReturnOrders.ReturnOrdersException('Validation failed: Status is required.');
            } catch (ReturnOrders.ReturnOrdersException e) {
                Assert.areEqual(
                    'Validation failed: Status is required.',
                    e.getMessage(),
                    'Exception message should match the value provided at construction'
                );
            }
            Test.stopTest();
        }
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    private static User buildTestUser() {
        adb_User builder = new adb_User();
        builder.persist();
        return (User) builder.record;
    }
}