<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>IMS Product Configurator</masterLabel>
    <description>GW-4777 / GW-5676 - IMS Product Configurator: Contract Adjustments (Inclusions / Exclusions, Model Quantity, Pricing Programs, On Location - Mobile Van) for the RCA product configurator (IMS Service Agreement).</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="rootTransactionLineId" type="String" label="Root Transaction Line Id"/>
            <property name="transactionId" type="String" label="Transaction (Quote) Id"/>
            <property name="currentProductId" type="String" label="Current Product Id"/>
            <property name="currentTransactionLineId" type="String" label="Current Transaction Line Id"/>
            <property name="currentProductName" type="String" label="Current Product Name"
                description="Product on screen (S01_DataManager.header.name)."/>
            <property name="allowedProducts" type="String" label="Allowed Products"
                description="Comma-separated product names the card is shown for; blank shows it for every product."/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>