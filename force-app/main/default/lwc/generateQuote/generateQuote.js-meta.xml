<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Generate Quote</masterLabel>
    <description>GCL-66: Opportunity, Trial, and Sample quote list, generation, and refresh.</description>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__FlowScreen</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Opportunity</object>
                <object>Trial__c</object>
                <object>Sample__c</object>
            </objects>
            <property
                name="recordPageContext"
                type="String"
                label="Record Page Context"
                description="Set to trial or sample on Trial and Sample record pages to scope quotes to that record."
                default="" />
        </targetConfig>
        <targetConfig targets="lightning__FlowScreen">
            <property name="recordId" type="String" label="Record Id" role="inputOnly"/>
            <property name="launchMode" type="String" label="Launch Mode" role="inputOnly"/>
        </targetConfig>
        <targetConfig targets="lightningCommunity__Default">
            <property name="recordId" type="String" label="Record Id" description="Opportunity Id from the portal record page." default="{!recordId}"/>
            <property name="isDealerPortal" type="Boolean" label="Dealer Portal" description="Hides internal quote actions and applies the dealer quote display rules." default="false"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>