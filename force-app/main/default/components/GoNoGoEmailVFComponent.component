<Apex:component controller="GoNoGoEmailController" access="global">
    <Apex:attribute name="caseId1" description="" assignTo="{!caseId}" type="String" /> 
    
   <apex:attribute name="FirstRequestedDateNonPreinstall" type="Datetime" description="First Date"/>
    
    <apex:attribute name="CustomerName" type="String" description="Customer Name"/>
    
    <apex:image URL="{!BannerUrlGoNoGo}" alt="STERIS Banner" width="982" height="180"/><br/><br/>
    
    <p>Hello, </p><br/>
    
    
 	<p style="max-width:982px;">The above order  has equipment scheduled to ship on or within (60) days.
                (Soonest capital equipment ship date is 
 		<span style="font-weight:700; background:#f3f3f3; padding: 1px 4px;"><apex:outputText value="{0, date, MMM d, yyyy}">
                    <apex:param value="{!FirstRequestedDateNonPreinstall}"/>
                </apex:outputText></span>.)
    <span style="font-weight:700;">Is the order a GO for shipment to Customer site?</span>
    </p><br/>

    <div style="max-width:982px;">
            
        <span style="display:inline-block; font-weight:bold;">
            Customer Name:
        </span>&nbsp;

        <span style="display:inline-block; vertical-align:top; text-transform: uppercase; max-width:982px;">
            <apex:outputPanel rendered="{!LEN(TRIM(CustomerName)) > 0}" layout="none">
                <apex:outputText value="{!TRIM(CustomerName)}"/>
            </apex:outputPanel>
        </span>
    </div>

    <br/>
    
     <!--apex:image URL="{!ReplyUrlGoNoGo}" alt="Reply Banner" width="982" height="170"/><br/><br/-->
    
     <span style="max-width:982px;">{!EmailBreakpoint}</span>
		
    <apex:outputPanel layout="block" style="margin-top:18px; font-family:Arial, sans-serif; font-size:14px; line-height:20px; max-width:982px;">

    <ol style="margin:0; padding-left:22px;">

        <!-- YES -->
        <li style="margin-bottom:10px;">
            <span style="font-weight:700; color:#0a7d24;">YES</span>
            – Customer is ready, willing, and able to receive the equipment as scheduled.

            <div style="margin-top:6px; padding-left:18px;">
                <span>a.</span><span style="font-weight:700; color:#0a7d24; text-decoration:underline;">If Yes</span>
                – Reply to this email with 
                <span style="font-weight:700;">“AM: Yes”</span> 
                or 
                <span style="font-weight:700;">“IPM: Yes”</span>
            </div>
        </li>

        <!-- NO -->
        <li style="margin-bottom:10px;">
            <span style="font-weight:700; color:#b00020;max-width:982px;">NO</span>
            – The Customer is not ready to receive. A call is required between the AM, IPM/PM, and me to discuss further. 
            I will set up the call if I receive a No Go from one or both parties.

            <div style="margin-top:6px; padding-left:18px;">
                <span>a.</span><span style="font-weight:700; color:#b00020; text-decoration:underline;">If No</span>
                – Reply to this email with 
                <span style="font-weight:700;">“AM: No”</span>
                or 
                <span style="font-weight:700;">“IPM: No”</span>
            </div>
        </li>

    </ol>

</apex:outputPanel>
<span style="max-width:982px;">{!EmailBreakpointEndLine}</span>
    
    
		<p style="max-width:982px;margin-top:18px; font-family: Arial, Helvetica, sans-serif; font-size:14px; line-height:1.5; color:#d32f2f; font-weight:700; max-width:982px;">
       			 A response is required within 48 hours from AM and PM. If a response is not received, we will begin our escalation process.
    		</p>
	
 <table width="982" style="border-collapse: collapse;
                  font-family: Arial, sans-serif; margin-top:10px;">
		
    	
<tr style="background-color:#89C3E6; color:black;">
            <td colspan="2" 
                style="padding:10px; text-align:center; font-weight:bold; 
                       border:2px solid #4F4F4F;">
                Hold Status
            </td>
        </tr>

        
        <tr>
            <td style="width:40%; padding:10px; border:2px solid #4F4F4F; 
                       background:#F2F2F2; font-weight:bold;">
                Holds Remaining on Order
            </td>
            <td style="padding:10px; border:2px solid #4F4F4F;">
                {!activeHolds}
            </td>
        </tr>

       
        <tr>
            <td style="width:40%; padding:10px; border:2px solid #4F4F4F; 
                       background:#F2F2F2; font-weight:bold;">
                Does the order contain a Planning Hold?
            </td>
            <td style="padding:10px; border:2px solid #4F4F4F;">
                <span style="color:red; font-weight:bold;">
                    {!IsPlannigHold}
                </span>
            </td>
        </tr>

      
        <tr>
            <td style="width:40%; padding:10px; border:2px solid #4F4F4F; 
                       background:#F2F2F2; font-weight:bold;">
                If yes, provide the unit and associated lines
            </td>
            <td style="padding:10px; border:2px solid #4F4F4F; font-style:italic;">
                {!PlanningHoldDetails}
            </td>
        </tr>
    </table><br/>
		
    <p style="display:inline-block; font-weight:bold;">
        Equipment Shipping:
    </p> 
    
    <table width="982" style="border-collapse: collapse; font-family: Arial, sans-serif;">
        <tr style="background-color: #4F81BD; color: white; font-weight: bold;">
            <td style="padding: 8px; border: 1px solid #ccc;">Item Number</td>
            <td style="padding: 8px; border: 1px solid #ccc;">Line Number</td>
            <td style="padding: 8px; border: 1px solid #ccc;">Schedule Date</td>
            <td style="padding: 8px; border: 1px solid #ccc;">Quantity</td>
            <td style="padding: 8px; border: 1px solid #ccc;">Item Description</td>
            <td style="padding: 8px; border: 1px solid #ccc;">Ship To Location</td>
        </tr>

        <apex:repeat value="{!shippingLineItems}" var="li">
            <tr>
                <td style="padding: 8px; border: 1px solid #ccc;">
                    <apex:outputText value="{!li.itemNumber}"/>
                </td>
                <td style="padding: 8px; border: 1px solid #ccc;">
                    <apex:outputText value="{!li.lineNumber}"/>
                </td>
                <td style="padding: 8px; border: 1px solid #ccc;">
                    <apex:outputText value="{0,date,MMM dd yyyy}">
                        <apex:param value="{!li.shipDate}"/>
                    </apex:outputText>
                </td>
                <td style="padding: 8px; border: 1px solid #ccc;">
                    <apex:outputText value="{!li.qty}"/>
                </td>
                <td style="padding: 8px; border: 1px solid #ccc;">
                    <apex:outputText value="{!li.itemDescription}"/>
                </td>
                <td style="padding: 8px; border: 1px solid #ccc;">
                    <apex:outputPanel rendered="{!LEN(TRIM(li.street)) > 0}" layout="none">
                        <apex:outputText value="{!TRIM(li.street)}"/>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!LEN(TRIM(li.city)) > 0}" layout="none">
                        <apex:outputText value=", {!TRIM(li.city)}"/>
                    </apex:outputPanel><apex:outputPanel rendered="{!LEN(TRIM(li.state)) > 0}" layout="none">
                        <apex:outputText value=", {!TRIM(li.state)}"/>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!LEN(TRIM(li.postalCode)) > 0}" layout="none">
                        <apex:outputText value=", {!TRIM(li.postalCode)}"/>
                    </apex:outputPanel><apex:outputPanel rendered="{!LEN(TRIM(li.country)) > 0}" layout="none">
                        <apex:outputText value=", {!TRIM(li.country)}"/>
                    </apex:outputPanel>
                </td>
            </tr>
        </apex:repeat>
    </table>
    
	<p>
        Thank you for your input.
    </p>
    
    <apex:outputText value="{!EmailSignature}" escape="false"/><br/><br/>
     
    <c:ReplyThreadInternalExternal caseId1="{!caseId}"
            threadType1="Internal"
        />


    
</apex:component>