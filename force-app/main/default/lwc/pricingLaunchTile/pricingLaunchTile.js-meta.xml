<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Pricing Launch Tile</masterLabel>
    <description>Spotlight-style tile that opens a tab (default: Pricing Programs).</description>
    <targets>
        <target>lightning__HomePage</target>
        <target>lightning__AppPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__HomePage,lightning__AppPage">
            <property name="tileTitle" type="String" label="Title" default="Pricing Programs"/>
            <property name="tileDescription" type="String" label="Description" default="Create and maintain pricing programs, Mobile Van programs and inclusion rules."/>
            <property name="tabApiName" type="String" label="Tab API Name" default="Pricing_Programs"/>
            <property name="iconName" type="String" label="Icon (SLDS name)" default="standard:pricebook"/>
            <property name="matchSpotlight" type="Boolean" label="Light-blue band like Pricing Spotlight" default="false"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>