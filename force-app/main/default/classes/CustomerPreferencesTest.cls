/**
 * @description Test class for CustomerPreferences domain class.
 *              Covers constructor and domain exception.
 */
@IsTest
private class CustomerPreferencesTest {

    @IsTest
    static void shouldConstructDomain_WhenValidRecordListProvided() {
        /********************************************
         * SETUP
         ********************************************/
        User testUser = new User(id=UserInfo.getUserId()); // Use current user to avoid permission issues in test context

        System.runAs(testUser) {
            /********************************************
             * GIVEN
             ********************************************/
            List<CustomerPreference__c> preferenceList = new List<CustomerPreference__c>{
                (CustomerPreference__c) new adb_CustomerPreference().name('Pref 1').record,
                (CustomerPreference__c) new adb_CustomerPreference().name('Pref 2').record
            };

            /********************************************
             * WHEN
             ********************************************/
            Test.startTest();
            CustomerPreferences domain = new CustomerPreferences(preferenceList);
            Test.stopTest();

            /********************************************
             * THEN
             ********************************************/
            Assert.isNotNull(domain, 'Domain instance should be created from a valid record list');
        }
    }

    @IsTest
    static void shouldConstructDomain_WhenEmptyListProvided() {
        /********************************************
         * SETUP
         ********************************************/
        User testUser = new User(id=UserInfo.getUserId()); // Use current user to avoid permission issues in test context

        System.runAs(testUser) {
            /********************************************
             * WHEN
             ********************************************/
            Test.startTest();
            CustomerPreferences domain = new CustomerPreferences(new List<CustomerPreference__c>());
            Test.stopTest();

            /********************************************
             * THEN
             ********************************************/
            Assert.isNotNull(domain, 'Domain instance should be created from an empty list without error');
        }
    }

    @IsTest
    static void shouldThrowCustomerPreferencesException_WhenExceptionIsRaised() {
        /********************************************
         * SETUP
         ********************************************/
        User testUser = new User(id=UserInfo.getUserId()); // Use current user to avoid permission issues in test context

        System.runAs(testUser) {
            /********************************************
             * WHEN / THEN
             ********************************************/
            Test.startTest();
            try {
                throw new CustomerPreferences.CustomerPreferencesException('Name is required.');
            } catch (CustomerPreferences.CustomerPreferencesException e) {
                Assert.areEqual(
                    'Name is required.',
                    e.getMessage(),
                    'Exception message should match the value provided at construction'
                );
            }
            Test.stopTest();
        }
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    private static User buildTestUser() {
        adb_User builder = new adb_User();
        builder.persist();
        return (User) builder.record;
    }
}