<apex:page standardController="Order" extensions="OrderCaseController">
    
    <apex:includeScript value="/support/console/66.0/integration.js"/>

    <script type="text/javascript">
        function setCaseTitle() {
            if (sforce.console.isInConsole()) {
                sforce.console.setTabTitle('{!JSENCODE(relatedCase.Subject)}');
                sforce.console.getFocusedPrimaryTabId(function(result) {
                    sforce.console.setTabTitle('{!JSENCODE(relatedCase.Subject)}', result.id);
                });
            }            
        }

        if (typeof sforce !== 'undefined' && sforce.console) {
            window.addEventListener('load', function() {
                setTimeout(setCaseTitle, 200);
            });
        }
    </script>
</apex:page>