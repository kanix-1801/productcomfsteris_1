	<apex:attribute name="accountName" type="String" description="Account Name"/>
    <apex:attribute name="poNumber" type="String" description="Po Number"/>
    <apex:attribute name="orderNumber" type="string" description="Order Number"/>
    
    <apex:image URL="{!BannerUrlCOAProject}" alt="STERIS Banner"/>
     
    
     <p>Dear {!PurchasingContactPO},</p>
    
