<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>EPP Opportunity Products</masterLabel>
    <description>GC-3431 Displays and adds separately filtered EPP capital equipment or consumable Opportunity Products.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Opportunity</object>
            </objects>
            <property
                name="productMode"
                type="String"
                label="Product Mode"
                description="Choose Capital or Consumable."
                datasource="Capital,Consumable"
                default="Capital"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>