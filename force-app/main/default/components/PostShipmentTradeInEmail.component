<apex:component controller="ShipDNEmailController" access="global">
     <Apex:attribute name="caseId1" description="" assignTo="{!caseId}" type="String" />  
        <apex:attribute name="CustomerName" type="String" description="Customer Name"/>

    <apex:image URL="{!BannerUrlSDN}" alt="STERIS Banner" width="982" height="180"/>
    Hello &nbsp;<apex:outputText value="{!(FirstName)}"/>,
    <br/>
    The trade-in on this order is now [30/60/90] days beyond the delivery  installation of your equipment.  
    <br/>
    As of today, we have not received this trade-in. Please confirm if this trade-in will be sent back to STERIS, or if it should be cancelled off the order.  
    <br/>
    If we have not received a response within 90 days of delivery  installation, this trade-in will be cancelled and &nbsp; <apex:outputPanel rendered="{!LEN(TRIM(CustomerName)) > 0}" layout="none">
               	    <apex:outputText value="{!TRIM(CustomerName)}"/>
            	</apex:outputPanel> &nbsp; will be responsible for any short paid invoices related to the trade-in.
    <br/>
    Thank you
     <apex:outputText value="{!EmailSignature}" escape="false"/><br/><br/>
     
    <c:ReplyThreadInternalExternal caseId1="{!caseId}"
            threadType1="External"
        />
</apex:component>