<apex:page showHeader="false"
    sidebar="false"
    standardStylesheets="false"
    applyHtmlTag="true"
    applyBodyTag="true"
    docType="html-5.0">

<html>

<head>

    <title>Print Return Order</title>

    <style>

        html,
        body {

            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background: #f3f3f3;

        }

        .pdf-container {

            width: 100%;
            margin-bottom: 20px;

        }

        iframe {

            width: 100%;
            height: 100vh;
            border: none;
            background: white;

        }

    </style>

</head>

<body>

    <div class="pdf-container">

        <iframe
            src="/sfc/servlet.shepherd/version/download/{!$CurrentPage.parameters.ro}">
        </iframe>

    </div>

    <div class="pdf-container">

        <iframe
            src="/sfc/servlet.shepherd/version/download/{!$CurrentPage.parameters.label}">
        </iframe>

    </div>

</body>

</html>

</apex:page>